# Supabase project (EU region). Publishable/anon key only; never the service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Same-origin route served by the geo-gate Worker. Leave as is in production.
VITE_CREATE_FAMILY_URL=/api/create-family

# Date of the privacy notice parents consent to (YYYY-MM-DD).
VITE_POLICY_VERSION=2026-10-01
