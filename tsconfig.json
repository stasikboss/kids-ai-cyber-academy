{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "supabase/functions/_shared/**/*.ts",
    "supabase/tests/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "content/source/**/*.ts"
  ]
}
