# Edge Function secrets. Locally: copy to supabase/functions/.env.
# Hosted: `npx supabase secrets set --env-file supabase/functions/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

ANTHROPIC_API_KEY=sk-ant-...

# Shared with the geo-gate Worker. Generate with: openssl rand -hex 32
GATE_SECRET=

# Comma-separated origins allowed to call tutor-chat from a browser.
ALLOWED_ORIGINS=http://localhost:5173,https://app.example.co.il

# Countries allowed to create a family. Launch is Israel-only.
ALLOWED_COUNTRIES=IL

# Optional: local school names the PII check should block, comma-separated.
SCHOOL_NAMES=

# --- Billing -----------------------------------------------------------------
# Where the web app lives; Grow returns parents here after paying.
APP_URL=http://localhost:5173

# Grow (Meshulam). sandbox until Grow approves the integration, then production.
GROW_ENV=sandbox
GROW_USER_ID=
# The recurring (standing order) page code Grow issues for the business.
GROW_PAGE_CODE=
# Filters noise on the public webhook URL. Generate with: openssl rand -hex 24
# Register https://<project>.supabase.co/functions/v1/billing-webhook?k=<this> with
# Grow for monthly charges, separately for sandbox and production.
GROW_WEBHOOK_SECRET=

# icount (default): invoices from iCount. gateway: Grow issues them itself.
INVOICING=icount
ICOUNT_COMPANY_ID=
ICOUNT_USER=
ICOUNT_PASSWORD=
